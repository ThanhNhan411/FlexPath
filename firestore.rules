rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Users
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && 
        incoming().email is string &&
        incoming().createdAt is string;
      allow update: if isOwner(userId) && 
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']);
    }

    // 2. Exercises (Read-only for users)
    match /exercises/{exerciseId} {
      allow read: if isSignedIn();
    }

    // 3. Workouts
    function validWorkout(d) {
      return d.keys().hasOnly(['userId', 'name', 'startTime', 'endTime', 'duration', 'status', 'calories', 'totalVolume', 'notes'])
        && d.status in ['active', 'completed', 'cancelled']
        && d.startTime is string
        && (!('name' in d) || (d.name is string && d.name.size() <= 200))
        && (!('notes' in d) || (d.notes is string && d.notes.size() <= 5000))
        && (!('endTime' in d) || d.endTime is string)
        && (!('duration' in d) || (d.duration is number && d.duration >= 0))
        && (!('calories' in d) || (d.calories is number && d.calories >= 0))
        && (!('totalVolume' in d) || (d.totalVolume is number && d.totalVolume >= 0));
    }

    match /workouts/{workoutId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
        incoming().userId == request.auth.uid &&
        validWorkout(incoming());

      allow update: if isSignedIn() &&
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        validWorkout(incoming()) && (
          // Action: Complete
          (incoming().status == 'completed' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'endTime', 'duration', 'calories', 'totalVolume'])) ||
          // Action: Edit Notes
          (incoming().diff(existing()).affectedKeys().hasOnly(['notes', 'name', 'totalVolume']))
        );

      allow delete: if isSignedIn() && existing().userId == request.auth.uid;

      // Logs (Subcollection)
      match /logs/{logId} {
        allow read, delete: if isWorkoutOwner(workoutId);
        allow create, update: if isWorkoutOwner(workoutId) &&
          incoming().exerciseId is string &&
          incoming().sets is list &&
          incoming().sets.size() <= 100;
      }
    }

    // 4. Workout Templates
    function validTemplate(d) {
      return d.keys().hasOnly(['userId', 'name', 'description', 'exercises', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && (!('description' in d) || (d.description is string && d.description.size() <= 1000))
        && d.exercises is list && d.exercises.size() <= 100
        && d.updatedAt is string;
    }

    match /workout_templates/{templateId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
        incoming().userId == request.auth.uid &&
        validTemplate(incoming());

      allow update: if isSignedIn() &&
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        validTemplate(incoming());

      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // 5. Health Profiles
    // unlockedAchievements may be written before the body metrics exist, so
    // the metrics are optional but range-checked when present.
    function validHealthProfile(d) {
      return d.keys().hasOnly(['height', 'weight', 'age', 'gender', 'bmi', 'updatedAt', 'unlockedAchievements', 'weeklyGoal'])
        && d.updatedAt is string
        && (!('height' in d) || (d.height is number && d.height >= 50 && d.height <= 300))
        && (!('weight' in d) || (d.weight is number && d.weight >= 20 && d.weight <= 500))
        && (!('age' in d) || (d.age is number && d.age >= 1 && d.age <= 120))
        && (!('gender' in d) || (d.gender is string && d.gender.size() <= 20))
        && (!('bmi' in d) || d.bmi is number)
        && (!('weeklyGoal' in d) || (d.weeklyGoal is number && d.weeklyGoal >= 1 && d.weeklyGoal <= 7))
        && (!('unlockedAchievements' in d) || (d.unlockedAchievements is list && d.unlockedAchievements.size() <= 200));
    }

    match /health_profiles/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && validHealthProfile(incoming());
      allow update: if isOwner(userId) && validHealthProfile(incoming());
    }

    // 6. Body measurements (append-only history: create and delete, no edits)
    function validMeasurement(d) {
      return d.keys().hasOnly(['userId', 'date', 'weight', 'bodyFat', 'waist', 'chest', 'hips', 'arm', 'thigh', 'note', 'createdAt'])
        && d.keys().hasAny(['weight', 'bodyFat', 'waist', 'chest', 'hips', 'arm', 'thigh'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.createdAt is string
        && (!('weight' in d) || (d.weight is number && d.weight >= 20 && d.weight <= 500))
        && (!('bodyFat' in d) || (d.bodyFat is number && d.bodyFat >= 2 && d.bodyFat <= 70))
        && (!('waist' in d) || (d.waist is number && d.waist >= 30 && d.waist <= 250))
        && (!('chest' in d) || (d.chest is number && d.chest >= 40 && d.chest <= 250))
        && (!('hips' in d) || (d.hips is number && d.hips >= 40 && d.hips <= 250))
        && (!('arm' in d) || (d.arm is number && d.arm >= 10 && d.arm <= 80))
        && (!('thigh' in d) || (d.thigh is number && d.thigh >= 20 && d.thigh <= 120))
        && (!('note' in d) || (d.note is string && d.note.size() <= 500));
    }

    match /body_measurements/{measurementId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && validMeasurement(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    function isWorkoutOwner(workoutId) {
      return isSignedIn() && get(/databases/$(database)/documents/workouts/$(workoutId)).data.userId == request.auth.uid;
    }
  }
}
